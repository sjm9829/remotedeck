{
  "name": "@remotedeck/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./session/manager": {
      "types": "./dist/session/manager.d.ts",
      "import": "./dist/session/manager.js"
    },
    "./session/transport": {
      "types": "./dist/session/transport.d.ts",
      "import": "./dist/session/transport.js"
    },
    "./session/ringbuffer": {
      "types": "./dist/session/ringbuffer.d.ts",
      "import": "./dist/session/ringbuffer.js"
    },
    "./ticket": {
      "types": "./dist/ticket.d.ts",
      "import": "./dist/ticket.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./sqliteStore": {
      "types": "./dist/sqliteStore.d.ts",
      "import": "./dist/sqliteStore.js"
    },
    "./session/sftp-transport": {
      "types": "./dist/session/sftp-transport.d.ts",
      "import": "./dist/session/sftp-transport.js"
    },
    "./session/path": {
      "types": "./dist/session/path.d.ts",
      "import": "./dist/session/path.js"
    },
    "./session/target": {
      "types": "./dist/session/target.d.ts",
      "import": "./dist/session/target.js"
    },
    "./session/sftp-manager": {
      "types": "./dist/session/sftp-manager.d.ts",
      "import": "./dist/session/sftp-manager.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/**/*.test.js"
  },
  "dependencies": {
    "@remotedeck/protocol": "*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@remotedeck/types": "*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
