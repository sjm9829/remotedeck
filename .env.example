# RemoteDeck environment variables

# Master key for AES-256-GCM encryption (32 bytes, 64 hex chars). REQUIRED.
# The server fails closed at startup if this is missing or malformed.
REMOTEDECK_MASTER_KEY=

# API bearer token. REQUIRED. The server fails closed at startup if this is
# missing or shorter than 32 characters. Requests to /api/* and /ws must present
# it as "Authorization: Bearer <token>"; only /healthz is served unauthenticated.
REMOTEDECK_API_TOKEN=

# Comma-separated explicit CORS allow-list of origins (e.g. http://localhost:5173).
# Empty/unset => same-origin only (no cross-origin allowed).
REMOTEDECK_ALLOWED_ORIGINS=

# Server port
PORT=4100

# Database path
DATABASE_PATH=./data/remotedeck.db

# Log level
LOG_LEVEL=info
