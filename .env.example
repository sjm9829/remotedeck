# RemoteDeck environment variables

# ── Server (core-server) ─────────────────────────────────────────────────────────

# Master key for AES-256-GCM encryption (32 bytes, 64 hex chars). REQUIRED.
# The server fails closed at startup if this is missing or malformed.
REMOTEDECK_MASTER_KEY=

# API bearer token. REQUIRED. The server fails closed at startup if this is
# missing or shorter than 32 characters. Requests to /api/* and /ws must present
# it as "Authorization: Bearer <token>"; only /healthz is served unauthenticated.
# In same-origin (Workbench proxy) mode the proxy handles this header;
# the browser client never sees this token.
REMOTEDECK_API_TOKEN=

# Comma-separated explicit CORS allow-list of origins (e.g. http://localhost:5173).
# Empty/unset => same-origin only (no cross-origin allowed).
REMOTEDECK_ALLOWED_ORIGINS=

# Listen (bind) host. OPTIONAL. Must be a valid IPv4/IPv6 address literal
# (hostnames are rejected; the server fails closed otherwise).
#   Default/unset  => 127.0.0.1 (loopback-only; recommended for host deployments).
#   Set 0.0.0.0     to bind all interfaces (e.g. inside Docker/compose that
#                   publishes a host port). docker-compose.yml sets this explicitly.
# Example (loopback-only): REMOTEDECK_LISTEN_HOST=127.0.0.1
# Example (all interfaces, Docker only): REMOTEDECK_LISTEN_HOST=0.0.0.0
REMOTEDECK_LISTEN_HOST=127.0.0.1

# Server port
PORT=4100

# Database path
DATABASE_PATH=./data/remotedeck.db

# Log level
LOG_LEVEL=info

# Detached-session idle timeout, in milliseconds. OPTIONAL.
#   A detached SSH/SFTP terminal tab (browser tab closed or network dropped) is kept
#   alive on the server so you can reconnect and resume with its scrollback. After this
#   much idle time with no attached client, the session is closed.
#     Default/unset => 300000 (5 minutes).
#     0            => never close on idle; detached sessions are kept indefinitely,
#                    like a tmux session that survives disconnects until the server stops.
#   Must be a non-negative integer; otherwise the server fails closed at startup.
# Example (keep sessions open indefinitely, tmux-style): REMOTEDECK_IDLE_TIMEOUT=0
REMOTEDECK_IDLE_TIMEOUT=300000

# ── Dev client build (Vite environment variables) ───────────────────────────────
# These are build-time variables for the dev-client (Vite). Prefix with VITE_ so
# they are available in the browser bundle via import.meta.env.
# Set them in the shell when running npm run build or vite build.

# VITE_REMOTEDECK_BASE
#   Vite public base path. Set to '/remotedeck/' when serving static assets
#   behind a reverse proxy sub-path (e.g. Workbench at /remotedeck/).
#   Default: '/' (served from root).
#   Example: VITE_REMOTEDECK_BASE=/remotedeck/

# VITE_REMOTEDECK_MODE
#   'same-origin'  (default) – same-origin proxy mode (e.g. behind Workbench);
#                   no credential inputs in the UI; cookies are used for auth.
#   'direct'                 – direct-connect mode; the UI shows API base URL
#                   and token inputs. Token is stored in memory only (React state).
#                   Must be set explicitly; missing or invalid values default to
#                   'same-origin' so that a production build never accidentally
#                   exposes credential input fields.
#   Example: VITE_REMOTEDECK_MODE=same-origin

# Dev server (direct mode, requires explicit setting):
#   VITE_REMOTEDECK_MODE=direct npm run dev:client

# Build command for Workbench deployment (same-origin is the default):
#   VITE_REMOTEDECK_BASE=/remotedeck/ npm run build --workspace=apps/dev-client
# Or explicitly:
#   VITE_REMOTEDECK_BASE=/remotedeck/ VITE_REMOTEDECK_MODE=same-origin npm run build --workspace=apps/dev-client
